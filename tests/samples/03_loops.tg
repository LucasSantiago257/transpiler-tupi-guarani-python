# Exercita as três estruturas de repetição: aja (while), rupi (for) e japo..aja (do..while).
tekoha
  papy i, soma.
  papy j.
  papy k.

  soma = 0.

  # while: aja
  i = 1.
  aja (i <= 5) {
    soma = soma + i.
    i = i + 1.
  }
  hei(soma).

  # for: rupi (init ; cond . passo)
  rupi (j = 1. j <= 3. j = j + 1) {
    hei(j).
  }

  # do..while: japo { ... } aja ( cond ).
  k = 0.
  japo {
    k = k + 2.
  } aja (k < 6).
  hei(k).
opa.
