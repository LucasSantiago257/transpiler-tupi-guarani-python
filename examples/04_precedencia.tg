# Verifica precedência aritmética: *,/ ligam mais forte que +,-, e parênteses elevam.
tekoha
  papy a, b, c.
  papyvore d.

  a = 2.
  b = 3.
  c = a + b * 4.          # 2 + (3*4) = 14
  hei(c).

  c = (a + b) * 4.        # (2+3)*4 = 20
  hei(c).

  d = 10.0 / (a + b).     # 10 / 5 = 2.0
  hei(d).
opa.
