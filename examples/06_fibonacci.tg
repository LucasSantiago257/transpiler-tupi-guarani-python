# Fibonacci: Calcula e imprime os N primeiros termos da sequência de Fibonacci.
tekoha
  papy n, a, b, temp, i.

  hei("Quantos termos de Fibonacci deseja gerar?").
  monee(n).

  a = 0.
  b = 1.
  i = 0.

  aja (i < n) {
    hei(a).
    temp = a + b.
    a = b.
    b = temp.
    i = i + 1.
  }
opa.
